name = "amr-id-otp-relay"
main = "src/index.ts"
compatibility_date = "2026-11-11"

# Not deployed in stage 1. When Murad sends Cloudflare access, deploy this
# worker to a preview first. Production only after «выкатывай».
#
# Durable Object lives in Western Europe. R2 buckets must be created with
# jurisdiction "eu". The Vercel app talks to the DO via CF_DO_URL + CF_DO_SECRET.

# Secrets (wrangler secret put):
# OTP_RELAY_SECRET
# TG_OTP_BOT_TOKEN
# RESEND_API_KEY
# CF_DO_SECRET

[[durable_objects.bindings]]
name = "AMR_ID"
class_name = "AmrIdDo"

[[migrations]]
tag = "v1-amr-id-do"
new_sqlite_classes = ["AmrIdDo"]

# Location is set in code: env.AMR_ID.get(id, { locationHint = "weur" })

[[r2_buckets]]
binding = "R2"
bucket_name = "amr-id"
jurisdiction = "eu"
