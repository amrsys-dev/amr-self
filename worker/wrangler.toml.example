name = "amr-id-do-preview"
main = "src/do-worker.ts"
compatibility_date = "2026-11-11"
workers_dev = true

# Preview Durable Object worker. The OTP relay in src/index.ts is not deployed
# until a Telegram bot token is available. Do not bind R2 until it is enabled.
# Production only after «выкатывай». Never deploy over amr-master.
#
# Secrets (wrangler secret put):
# CF_DO_SECRET

[[durable_objects.bindings]]
name = "AMR_ID"
class_name = "AmrIdDo"

[[migrations]]
tag = "v1-amr-id-do"
new_sqlite_classes = ["AmrIdDo"]

# Location is set in code: env.AMR_ID.get(id, { locationHint: "weur" })
