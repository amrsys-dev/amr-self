# ---- App ----
# Preview / local test mode shows a one-time OTP in a clearly marked test banner.
# Test OTP is always disabled when VERCEL_ENV=production.
OTP_MODE=test

# Nick format: "xxx-xxx" (default, @AMR-417-283) or "xxxx-xxxx" (@AMR-4172-8301).
AMR_NICK_FORMAT=xxx-xxx

# Reissue retired nicks? Default is no (pending Murad).
AMR_NICK_REISSUE=false

# Public card URL prefix shown in QR / share (no DNS is configured in stage 1).
# Leave empty to use the current origin.
PUBLIC_CARD_ORIGIN=

# HMAC secret for session cookies. Generate a long random string. Never commit the real value.
SESSION_SECRET=

# ---- Cloudflare (wired, inactive until all four are set) ----
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=
CF_R2_BUCKET=

# ---- OTP providers (stubs; inactive until set) ----
# Telegram bot token for login / contact-verification codes.
TG_OTP_BOT_TOKEN=
# Optional: future Cloudflare Worker relay. Not deployed in stage 1.
OTP_RELAY_URL=
OTP_RELAY_SECRET=

# Email codes via Resend. Needs a verified domain later.
RESEND_API_KEY=
RESEND_FROM=AMR ID <noreply@example.com>
