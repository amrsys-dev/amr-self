# ---- App ----
# Preview / local test mode shows a one-time OTP in a clearly marked test banner.
# Test OTP is always disabled when VERCEL_ENV=production.
OTP_MODE=test

# Nick format: "xxx-xxx" (default, @AMR-417-283) or "xxxx-xxxx" (@AMR-4172-8301).
AMR_NICK_FORMAT=xxx-xxx

# Retired nicks are never reissued. This flag is ignored and always treated as false.
AMR_NICK_REISSUE=false

# One-time recovery codes issued at signup (1..10). Default 10. Codes are generated
# on the client and shown once — never sent to the server or Telegram.
AMR_RECOVERY_CODES=10

# Email as a 2FA / login channel is off until a domain is approved. Codes go via Telegram bot.
AMR_OTP_EMAIL=false

# Public card URL prefix shown in QR / share (no DNS is configured in stage 1).
# Leave empty to use the current origin.
PUBLIC_CARD_ORIGIN=

# HMAC secret for session cookies. Generate a long random string. Never commit the real value.
SESSION_SECRET=

# ---- Cloudflare ----
# KV is used when the first three are set. R2 stays inactive until a bucket is set.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=
# CF_R2_BUCKET=

# ---- OTP providers (stubs; inactive until set) ----
# Telegram bot token for login / contact-verification codes.
TG_OTP_BOT_TOKEN=
# Optional: future Cloudflare Worker relay. Not deployed in stage 1.
OTP_RELAY_URL=
OTP_RELAY_SECRET=

# Email codes via Resend. Needs a verified domain later.
RESEND_API_KEY=
RESEND_FROM=AMR ID <noreply@example.com>

# ---- Durable Object (preview worker amr-id-do-preview) ----
# When both are set, nick uniqueness, If-Match CAS and rate limits go to the DO.
# Rate limits stay in DO memory with a TTL and are not written to KV.
# CF_DO_URL=https://amr-id-do-preview.amrsys-dev.workers.dev
# CF_DO_SECRET=
# R2 jurisdiction (default eu). DO locationHint is weur in the worker config.
# CF_R2_JURISDICTION=eu
